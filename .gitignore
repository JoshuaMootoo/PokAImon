# -----------------------------------------------------------------------
# Pokemon Blue AI — .gitignore
# -----------------------------------------------------------------------

# --- ROM & save files (copyrighted / large binaries) ---
*.gb
*.gbc
*.rom
*.sav
*.state
*.ram
init.state

# --- Checkpoints (large, regenerated by training) ---
checkpoints/
checkpoints_old/
*.zip

# --- TensorBoard logs ---
logs/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
wheels/
*.spec
pip-log.txt

# --- Virtual environments ---
venv/
.venv/
env/bin/
env/lib/
env/include/
.env

# --- IDEs ---
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docview
*.sublime-project
*.sublime-workspace

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Misc ---
*.log
*.tmp
*.bak
*.swp
*~
